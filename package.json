{
  "name": "productroot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply productroot --local",
    "db:migrate:remote": "wrangler d1 migrations apply productroot --remote",
    "cf:build": "opennextjs-cloudflare build && node scripts/cf-sanitize-env.mjs",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/nextjs": "^7.9.15",
    "@opennextjs/cloudflare": "^1.20.12",
    "@xyflow/react": "^12.12.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true,
    "unrs-resolver@1.12.2": true
  }
}
