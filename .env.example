# Public URL of this deployment (used for Clerk authorised parties).
APP_URL=http://localhost:3000

# Sign-in (Clerk). Use the same Clerk application as MetaInfo and SocialBrewery
# for single sign-on across the product family. Without these keys, `next dev`
# runs as a single local user and production refuses requests.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: raises the GitHub API limit from 60 to 5,000 requests/hour for
# public repository assessments in workspaces that haven't connected GitHub.
# A fine-grained token with no permissions is enough.
GITHUB_TOKEN=

# Optional: MetaInfo deployment used for SEO / AI-search discoverability checks.
METAINFO_URL=
METAINFO_TOKEN=

# Encrypts per-workspace connection credentials (GitHub, SocialBrewery, uptime
# monitors). Required in production; any long random string, e.g.
# `openssl rand -base64 32`. Rotating it invalidates stored connections.
PRODUCTROOT_MASTER_KEY=

# Shared secret between the Worker's cron trigger and /api/cron/recheck.
CRON_SECRET=
